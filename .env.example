# ITD5 Agentic Stack environment
# The launcher copies this file to .env and generates the two required secrets.
# Never commit .env or paste its contents into tickets or chat.

# Official Paperclip image. Pin this to a release tag or digest for controlled deployments.
PAPERCLIP_IMAGE=ghcr.io/paperclipai/paperclip:latest

# Host settings
PAPERCLIP_PORT=3100
PAPERCLIP_PUBLIC_URL=http://localhost:3100
PAPERCLIP_DATA_DIR=./data/paperclip

# Safe workstation/private-LAN defaults
PAPERCLIP_DEPLOYMENT_MODE=authenticated
PAPERCLIP_DEPLOYMENT_EXPOSURE=private
PAPERCLIP_TELEMETRY_DISABLED=1
DO_NOT_TRACK=1

# Required. Leave blank only when using ./scripts/launch.sh, which generates them.
BETTER_AUTH_SECRET=
PAPERCLIP_TOOL_ACTION_SIGNING_SECRET=

# Optional provider credentials. Paperclip starts without them, but agents need
# at least one configured provider before they can run work.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
GOOGLE_API_KEY=

# Optional launcher behavior: auto installs gstack only when both Claude Code and
# Bun are already present. Use never to run Paperclip only.
GSTACK_INSTALL=auto
